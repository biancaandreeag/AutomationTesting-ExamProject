<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} %-5level %msg%n"/>
        </Console>

        <!-- cate un fisier pentru fiecare test, dupa numele pus in ThreadContext -->
        <Routing name="Routing">
            <Routes pattern="$${ctx:testName}">
                <Route key="$${ctx:testName}" ref="Console"/>
                <Route>
                    <File name="File-${ctx:testName}" fileName="target/logs/tests/${ctx:testName}.log" append="false">
                        <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %msg%n"/>
                    </File>
                </Route>
            </Routes>
        </Routing>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Routing"/>
        </Root>
    </Loggers>
</Configuration>
